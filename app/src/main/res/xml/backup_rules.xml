<?xml version="1.0" encoding="utf-8"?>
<!--
   Auto Backup rules for Android 11 and lower. Android 12+ reads data_extraction_rules.xml;
   keep the two lists identical.

   Nothing that logs in to anything leaves the phone:
   - kindle_secrets: SSH password and this phone's SSH key (Keystore-encrypted; the key can't be restored anyway)
   - kindle_settings: held the plain-text SSH password before 0.9, until the app migrates it
   - kindle_host_keys: pinned Kindle host keys; a restored phone should pin afresh
   - pagedrop_server: conversion server access and refresh tokens
   - pagedrop_discover_secrets: OPDS catalog passwords (Keystore-encrypted)
   - app_webview: browser cookies, storage and cache from the source browser
-->
<full-backup-content>
    <exclude domain="sharedpref" path="kindle_secrets.xml" />
    <exclude domain="sharedpref" path="kindle_settings.xml" />
    <exclude domain="sharedpref" path="kindle_host_keys.xml" />
    <exclude domain="sharedpref" path="pagedrop_server.xml" />
    <exclude domain="sharedpref" path="pagedrop_discover_secrets.xml" />
    <exclude domain="root" path="app_webview" />
</full-backup-content>
